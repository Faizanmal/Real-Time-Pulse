# Use subdomains so the faizanmalik.me portfolio at the bare domain is untouched.
APP_DOMAIN=pulse.faizanmalik.me
API_DOMAIN=pulse-api.faizanmalik.me
ACME_EMAIL=your-email@example.com

# Generate each secret independently with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-unique-random-64-character-hex-value
REDIS_PASSWORD=replace-with-a-unique-random-64-character-hex-value
JWT_SECRET=replace-with-a-unique-random-64-character-hex-value
ENCRYPTION_KEY=replace-with-a-unique-random-64-character-hex-value
ONBOARDING_FUNNEL_HMAC_KEY=replace-with-a-unique-random-64-character-hex-value

NODE_ENV=production
AUTH_LEGACY_TOKEN_RESPONSES=false
INTEGRATION_TOKEN_ENCRYPTION_WRITE_ENABLED=true

# Optional integrations. Leave blank when unused.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_LIVE_BILLING_ENABLED=false
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
