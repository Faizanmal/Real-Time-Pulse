# Local development only. These are public placeholders, not production credentials.
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:3001
# Secure by default: auth endpoints set HttpOnly session cookies and omit tokens from JSON.
# Production startup and auth routes reject this compatibility mode.
AUTH_LEGACY_TOKEN_RESPONSES=false

# New Integration rows use AES-256-GCM by default. Set false only while preparing a
# rolling upgrade; production requires the explicit temporary prepare-phase marker.
INTEGRATION_TOKEN_ENCRYPTION_WRITE_ENABLED=true
# INTEGRATION_TOKEN_ENCRYPTION_ROLLOUT_PHASE=prepare

# Matches the local-only Postgres service in docker-compose.yml.
DATABASE_URL=postgresql://pulse_dev:pulse_local_only_password@127.0.0.1:5432/pulse_dev?schema=public
TEST_DATABASE_URL=postgresql://pulse_test:pulse_test_only_password@127.0.0.1:55432/pulse_test?schema=public

# Development placeholders only. Replace with unique random values outside local use.
JWT_SECRET=local-only-placeholder-jwt-secret-change-before-deploy
ENCRYPTION_KEY=local-only-placeholder-encryption-key-change-before-deploy
# Optional: random 32+ byte server-only key for consented onboarding funnel pseudonyms.
ONBOARDING_FUNNEL_HMAC_KEY=local-only-placeholder-funnel-hmac-key-32-bytes
JWT_EXPIRATION=15m
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Optional integrations stay disabled for local mocks and contract tests.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_LIVE_BILLING_ENABLED=false
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
